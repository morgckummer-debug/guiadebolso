# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings → API) e um segredo escolhido por você
# para o webhook do Kiwify. Nunca commite o .env.local de verdade.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Qualquer texto aleatório e difícil de adivinhar — usado para confirmar que
# a chamada ao endpoint /api/webhooks/kiwify realmente veio do Kiwify
# (configure a mesma string na URL do webhook, como
# https://SEU-DOMINIO/api/webhooks/kiwify?secret=ESSE-VALOR).
KIWIFY_WEBHOOK_SECRET=
